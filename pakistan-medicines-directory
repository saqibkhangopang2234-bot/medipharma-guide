const translations = {
  en: {
    title: "Pakistan Medicines Directory",
    subtitle: "Search medicines, brands and generic names.",
    search: "Search medicine, brand or generic name...",
    all: "All companies",
    count: n => `${n} products shown`,
    generic: "Generic name",
    brand: "Brand name",
    company: "Company / manufacturer",
    strength: "Strength",
    form: "Dosage form",
    uses: "Uses",
    side: "Side effects",
    warnings: "Warnings",
    safetyTitle: "Medical information notice",
    safetyText: "Educational information only; not a substitute for a doctor or pharmacist. Verify the official product leaflet. Do not start, stop or change a medicine based only on this website.",
    footer: "Verify product registration, manufacturer and current product information with DRAP.",
    empty: "No matching medicines found."
  },
  ur: {
    title: "پاکستان ادویات ڈائریکٹری",
    subtitle: "ادویات، برانڈ اور اصل نام تلاش کریں۔",
    search: "دوا، برانڈ یا اصل نام تلاش کریں...",
    all: "تمام کمپنیاں",
    count: n => `${n} ادویات دکھائی جا رہی ہیں`,
    generic: "اصل نام",
    brand: "برانڈ کا نام",
    company: "کمپنی / مینوفیکچرر",
    strength: "طاقت",
    form: "قسم",
    uses: "استعمال",
    side: "مضر اثرات",
    warnings: "احتیاطی ہدایات",
    safetyTitle: "طبی معلومات سے متعلق نوٹس",
    safetyText: "یہ معلومات صرف تعلیمی مقصد کے لیے ہیں، ڈاکٹر یا فارماسسٹ کے مشورے کا متبادل نہیں۔ اصل پیکٹ کا لیف لیٹ دیکھیں۔ صرف اس ویب سائٹ کی بنیاد پر دوا شروع، بند یا تبدیل نہ کریں۔",
    footer: "دوا کی رجسٹریشن، کمپنی اور تازہ معلومات DRAP سے تصدیق کریں۔",
    empty: "کوئی متعلقہ دوا نہیں ملی۔"
  }
};

let language = "en";
const $ = id => document.getElementById(id);

function textFor(m, key) {
  return language === "ur" && m[key + "Ur"]
    ? m[key + "Ur"] : m[key] || "Not verified";
}

function render() {
  const t = translations[language];
  const query = $("search").value.trim().toLowerCase();
  const company = $("companyFilter").value;

  $("siteTitle").textContent = t.title;
  $("siteSubtitle").textContent = t.subtitle;
  $("search").placeholder = t.search;
  $("search").dir = language === "ur" ? "rtl" : "auto";
  $("safetyTitle").textContent = t.safetyTitle;
  $("safetyText").textContent = t.safetyText;
  $("footerText").textContent = t.footer;
  $("languageButton").textContent = language === "en" ? "اردو" : "English";
  document.documentElement.lang = language;
  document.documentElement.dir = "ltr";

  const results = medicines.filter(m => {
    const searchable = [
      m.id, m.generic, m.brand, m.company, m.strength, m.form
    ].join(" ").toLowerCase();
    return searchable.includes(query) &&
      (!company || m.company === company);
  });

  $("count").textContent = t.count(results.length);
  $("medicineGrid").innerHTML = results.length
    ? results.map(m => `
      <article class="card">
        <span class="tag">${escapeHTML(m.id)}</span>
        <h2>${escapeHTML(m.generic)}</h2>
        <p><span class="label">${t.brand}:</span>
          ${escapeHTML(m.brand)}</p>
        <p><span class="label">${t.company}:</span>
          ${escapeHTML(m.company)}</p>
        <div class="details">
          <p><strong>${t.strength}:</strong>
            ${escapeHTML(m.strength)}</p>
          <p><strong>${t.form}:</strong>
            ${escapeHTML(m.form)}</p>
          <p><strong>${t.uses}:</strong>
            ${escapeHTML(textFor(m, "uses"))}</p>
          <p><strong>${t.side}:</strong>
            ${escapeHTML(textFor(m, "side"))}</p>
          <p><strong>${t.warnings}:</strong>
            ${escapeHTML(textFor(m, "warnings"))}</p>
        </div>
      </article>`).join("")
    : `<p>${t.empty}</p>`;
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, ch => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;",
    '"': "&quot;", "'": "&#39;"
  })[ch]);
}

function initCompanies() {
  const select = $("companyFilter");
  [...new Set(medicines.map(m => m.company))]
    .sort()
    .forEach(name => {
      const option = document.createElement("option");
      option.value = name;
      option.textContent = name;
      select.appendChild(option);
    });
}

$("search").addEventListener("input", render);
$("companyFilter").addEventListener("change", render);
$("languageButton").addEventListener("click", () => {
  language = language === "en" ? "ur" : "en";
  render();
});

initCompanies();
render();
</script>
</body>
</html>
