    sideUr: "عموماً برداشت ہو جاتی ہے؛ الرجی ہو سکتی ہے۔ زیادہ مقدار جگر کو شدید نقصان پہنچا سکتی ہے۔",
    warnings: "Avoid taking multiple products containing paracetamol.",
    warningsUr: "ایک سے زیادہ پیراسیٹامول والی ادویات اکٹھی لینے سے گریز کریں۔"
  },
  {
    id: "MED0002",
    generic: "Amoxicillin + Clavulanic acid",
    brand: "Augmentin",
    company: "Verify current DRAP product record",
