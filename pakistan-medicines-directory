    form: "Tablet / oral suspension",
    uses: "Treatment of certain bacterial infections when prescribed.",
    usesUr: "ڈاکٹر کے مشورے سے بعض بیکٹیریا کے انفیکشن کے علاج کے لیے۔",
    side: "Diarrhoea, nausea, vomiting, rash; serious allergy is possible.",
    sideUr: "اسہال، متلی، قے یا خارش؛ شدید الرجی بھی ہو سکتی ہے۔",
    warnings: "Not for viral infections. Check penicillin allergy and the prescribed formulation.",
    warningsUr: "وائرل انفیکشن کے لیے نہیں۔ پینسلین الرجی اور دوا کی درست قسم کے بارے میں ڈاکٹر سے تصدیق کریں۔"
  },
  {
    id: "MED0003",
    generic: "Cetirizine",
    brand: "Brand varies",
    company: "Verify current DRAP product record",
    strength: "Varies by product",
    form: "Tablet / oral liquid",
    uses: "Relief of symptoms of allergic rhinitis and hives.",
    usesUr: "الرجی، چھینکوں اور چھپاکی کی علامات میں کمی۔",
    side: "Drowsiness, dry mouth and fatigue may occur.",
    sideUr: "غنودگی، منہ خشک ہونا یا تھکن ہو سکتی ہے۔",
    warnings: "Use caution with driving if drowsy; ask a professional about kidney disease.",
    warningsUr: "غنودگی کی صورت میں گاڑی نہ چلائیں؛ گردوں کی بیماری میں طبی مشورہ لیں۔"
  },
  {
    id: "MED0004",
    generic: "Omeprazole",
    brand: "Brand varies",
    company: "Verify current DRAP product record",
    strength: "Varies by product",
    form: "Capsule / tablet",
    uses: "Reduces stomach acid in selected acid-related conditions.",
    usesUr: "معدے میں تیزابیت سے متعلق بعض بیماریوں میں تیزاب کم کرتی ہے۔",
    side: "Headache, abdominal discomfort, nausea or diarrhoea may occur.",
    sideUr: "سر درد، پیٹ میں تکلیف، متلی یا اسہال ہو سکتا ہے۔",
    warnings: "Persistent symptoms or long-term use should be reviewed by a clinician.",
    warningsUr: "مسلسل علامات یا طویل استعمال کے لیے ڈاکٹر سے مشورہ کریں۔"
  },
  {
    id: "MED0005",
    generic: "Ibuprofen",
    brand: "Brand varies",
    company: "Verify current DRAP product record",
    strength: "Varies by product",
    form: "Tablet / suspension",
    uses: "Pain, fever and inflammation.",
    usesUr: "درد، بخار اور سوزش میں کمی۔",
    side: "Stomach upset; serious stomach bleeding and kidney problems can occur.",
    sideUr: "معدے میں تکلیف؛ معدے سے خون بہنے اور گردوں کے مسائل کا خطرہ ہو سکتا ہے۔",
    warnings: "Not suitable for everyone, including some people with ulcers, kidney disease or pregnancy.",
    warningsUr: "السر، گردوں کی بیماری یا حمل کی بعض حالتوں میں موزوں نہیں؛ ڈاکٹر سے پوچھیں۔"
  },
  {
    id: "MED0006",
    generic: "Metformin",
    brand: "Brand varies",
    company: "Verify current DRAP product record",
