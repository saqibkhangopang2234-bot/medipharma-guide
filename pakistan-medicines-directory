
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Bilingual Pakistan medicine directory with generic names, brands, uses and safety information.">
<title>Pakistan Medicines Directory</title>
<style>
:root {
  --primary: #0f766e;
  --bg: #f4f7f8;
  --card: #ffffff;
  --text: #172b35;
  --muted: #64748b;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, "Noto Sans Arabic", sans-serif;
  background: var(--bg);
  color: var(--text);
}
header {
  background: var(--primary);
  color: white;
  padding: 28px 18px;
}
.container { max-width: 1050px; margin: auto; }
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
h1 { margin: 0 0 8px; font-size: 27px; }
header p { margin: 0; line-height: 1.7; }
button, input, select { font: inherit; }
button, select {
  padding: 11px 14px;
  border: 1px solid #d6e0e5;
  border-radius: 9px;
  background: white;
  cursor: pointer;
}
main { padding: 24px 16px; }
.search-panel {
  display: grid;
  grid-template-columns: 1fr 220px;
  gap: 12px;
  margin-bottom: 20px;
}
input {
  width: 100%;
  padding: 14px;
  border: 1px solid #d6e0e5;
  border-radius: 9px;
}
.summary { color: var(--muted); margin: 12px 0; }
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}
.card {
  background: var(--card);
  border: 1px solid #e0e8eb;
  border-radius: 13px;
  padding: 18px;
  box-shadow: 0 3px 12px #18334408;
}
.card h2 { font-size: 20px; margin: 0 0 8px; }
.tag {
  display: inline-block;
  background: #e2f5f1;
  color: #115e59;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 12px;
  margin: 3px 0 9px;
}
.card p { line-height: 1.65; overflow-wrap: anywhere; }
.label { color: var(--muted); font-size: 13px; }
.details {
  border-top: 1px solid #e5ecef;
  margin-top: 12px;
  padding-top: 10px;
}
.safety {
  background: #fff7e6;
  padding: 13px;
  border-radius: 9px;
  line-height: 1.6;
  margin-top: 18px;
}
footer {
  padding: 24px 16px;
  text-align: center;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}
[hidden] { display: none !important; }
@media(max-width:600px) {
  .search-panel { grid-template-columns: 1fr; }
  .header-row { align-items: flex-start; flex-direction: column; }
  h1 { font-size: 23px; }
}
</style>
</head>
<body>
<header>
  <div class="container header-row">
    <div>
      <h1 id="siteTitle">Pakistan Medicines Directory</h1>
      <p id="siteSubtitle">Search medicines, brands and generic names.</p>
    </div>
    <button id="languageButton" type="button">اردو</button>
  </div>
</header>

<main class="container">
  <div class="search-panel">
    <input id="search" type="search"
      placeholder="Search medicine, brand or generic name..."
      aria-label="Search medicines">
    <select id="companyFilter" aria-label="Filter by company">
      <option value="">All companies</option>
    </select>
  </div>

  <p class="summary" id="count" aria-live="polite"></p>
  <section class="grid" id="medicineGrid" aria-label="Medicines"></section>

  <div class="safety">
    <strong id="safetyTitle">Medical information notice</strong>
    <p id="safetyText">
      This directory is for educational purposes only. It does not replace
      advice from a qualified doctor or pharmacist. Always check the
      official product leaflet. Do not start, stop or change a medicine
      based only on this website.
    </p>
  </div>
</main>

<footer>
  <p id="footerText">
    Verify product registration, manufacturer and current product information
    using the Drug Regulatory Authority of Pakistan (DRAP).
  </p>
  <a href="https://www.dra.gov.pk/" target="_blank"
     rel="noopener noreferrer">Official DRAP website</a>
  ·
  <a href="https://eapp.dra.gov.pk/WebProductIndex.php?view=pt24"
     target="_blank" rel="noopener noreferrer">Registered product search</a>
</footer>

<script>
const medicines = [
